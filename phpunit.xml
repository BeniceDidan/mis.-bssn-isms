<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Postgres, not the default sqlite :memory: — the schema relies on
             jsonb columns + raw GIN index statements (see assets/risks/etc.
             migrations) that sqlite can't run. Points at a dedicated
             kominfo_isms_test database on the same instance, never the real
             kominfo_isms one the demo runs on. Host, port, username and
             password are deliberately NOT set here: they come from each
             machine's own .env, so only the database name differs and no
             credential is committed. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="kominfo_isms_test"/>
        <env name="DB_URL" value=""/>
        <!-- Tests never call a live model: AI features fall back to the
             deterministic rule engine. Tests that need a model fake HTTP. -->
        <env name="AI_PROVIDER" value="none"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
